# ==============================================================================
# Confession Wall — Environment Variables Template
# Copy this file to .env and change the values before starting containers:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=confession_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_secret_password

# Frontend Exposed Port (Port on Ubuntu Host to access the website)
FRONTEND_PORT=80
